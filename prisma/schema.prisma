generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id              String   @id @default(uuid()) @db.Uuid
  nome            String
  responsavelNome String   @map("responsavel_nome")
  email           String   @unique
  telefone        String
  documento       String   @unique
  slug            String   @unique
  usuario         String   @unique
  senhaHash       String   @map("senha_hash")
  empresaAtiva    Boolean  @default(true) @map("empresa_ativa")
  adminAtivo      Boolean  @default(true) @map("admin_ativo")
  /// Último login do admin do tenant — usado só pro Super Admin enxergar saúde/atividade da loja, não afeta nenhuma regra de acesso.
  ultimoAcessoAdminEm DateTime? @map("ultimo_acesso_admin_em")
  /// Loja de demonstração (ex: pra mostrar a plataforma pra um prospect) — funciona igual a qualquer
  /// tenant real, mas é excluída dos totais agregados do dashboard do Super Admin (GMV, nº de lojas,
  /// nº de clientes etc.), pra não distorcer os números reais da plataforma.
  ehDemo Boolean @default(false) @map("eh_demo")

  // Perfil da loja (vitrine/admin da empresa)
  descricao             String? // tagline curta, ex: "20 anos de sabor baiano"
  sobre                 String? // texto livre exibido no rodapé/institucional
  endereco              String?
  horarioFuncionamento  String? @map("horario_funcionamento")
  instagramUrl          String? @map("instagram_url")
  facebookUrl           String? @map("facebook_url")
  logoUrl               String? @map("logo_url")
  taxaEntrega           Decimal @default(7.00) @map("taxa_entrega") @db.Decimal(10, 2)

  // Aparência (CMS da loja)
  corPrimaria       String  @default("#f97316") @map("cor_primaria")
  corSecundaria     String  @default("#dc2626") @map("cor_secundaria")
  faviconUrl        String? @map("favicon_url")
  heroUsarCarrossel Boolean @default(false) @map("hero_usar_carrossel")
  heroTitulo        String? @map("hero_titulo")
  heroSubtitulo     String? @map("hero_subtitulo")
  heroBadgeLabel    String? @map("hero_badge_label")
  heroImagemUrl     String? @map("hero_imagem_url")
  heroLinkUrl       String? @map("hero_link_url")

  /// Percentual (5 a 20) sobre o total vendido destinado ao dono da plataforma, definido pelo Super Admin.
  comissaoPercent Decimal @default(10.00) @map("comissao_percent") @db.Decimal(5, 2)
  /// Se true, o card "Comissão da plataforma" fica oculto no CRM do próprio tenant. Controlado só pelo Super Admin.
  ocultarComissaoTenant Boolean @default(false) @map("ocultar_comissao_tenant")

  // Indicação de lojas: cada tenant tem um código próprio pra indicar outros donos de loja pra
  // plataforma. Só o Super Admin cria empresas novas (não há autoatendimento) — o campo
  // "indicado por" é preenchido por ele no cadastro. Quando a fatura do indicado é paga pela
  // 1ª vez, o indicador ganha crédito (ConfiguracaoPlataforma.recompensaIndicacaoEmpresaValor),
  // aplicado automaticamente como desconto na próxima fatura gerada pra ele.
  codigoIndicacao               String?  @unique @map("codigo_indicacao")
  indicadaPorEmpresaId          String?  @map("indicada_por_empresa_id") @db.Uuid
  indicadaPor                   Empresa? @relation("IndicacoesEmpresa", fields: [indicadaPorEmpresaId], references: [id], onDelete: SetNull)
  indicadas                     Empresa[] @relation("IndicacoesEmpresa")
  indicacaoEmpresaRecompensada  Boolean  @default(false) @map("indicacao_empresa_recompensada")
  creditoIndicacaoEmpresa       Decimal  @default(0) @map("credito_indicacao_empresa") @db.Decimal(10, 2)

  /// Texto livre (institucional) — se vazio, o front usa um modelo padrão de LGPD com os dados da empresa.
  termosConteudo String? @map("termos_conteudo")

  /// Link oficial de avaliação do Google Meu Negócio (Perfil da Empresa no Google > Compartilhar perfil > link de avaliação).
  /// Não existe API pública do Google para publicar avaliações/fotos em nome do cliente — o link abre a própria página
  /// do Google, onde o cliente escreve a mensagem e anexa fotos pela interface oficial.
  googleBusinessReviewUrl String? @map("google_business_review_url")

  // Programa de fidelidade (CMS)
  fidelidadeLogoUrl      String? @map("fidelidade_logo_url") // se vazio, usa o logoUrl da loja
  fidelidadeValidadeDias Int?    @map("fidelidade_validade_dias") // prazo p/ resgatar o item grátis após ganhar; null = sem prazo
  fidelidadeAvisoFaltam  Int?    @map("fidelidade_aviso_faltam") // dispara aviso na loja quando faltar X unidades p/ o prêmio
  fidelidadeNomeItem     String? @map("fidelidade_nome_item") // nome genérico usado nas mensagens, ex: "lanches"

  /// Percentual de cashback (0-100) creditado no saldo do cliente sobre o subtotal de cada pedido ENTREGUE. 0/null = desativado.
  cashbackPercent Decimal? @map("cashback_percent") @db.Decimal(5, 2)

  /// SaltFood Coins — opt-in por loja pra participar da carteira global (ganhar e/ou gastar),
  /// independente do cashback local acima. Percentual sobre o subtotal, igual ao cashback.
  participaSaltfoodCoins Boolean  @default(false) @map("participa_saltfood_coins")
  saltfoodCoinsPercent   Decimal? @map("saltfood_coins_percent") @db.Decimal(5, 2)

  // Funcionalidades da loja (opt-in) — cada função só fica visível/ativa na vitrine depois que o
  // próprio tenant aprova e liga aqui no admin dele. Todas nascem desligadas por padrão.
  habilitarFavoritos           Boolean @default(false) @map("habilitar_favoritos")
  habilitarPedirDeNovo         Boolean @default(false) @map("habilitar_pedir_de_novo")
  habilitarRankingFidelidade   Boolean @default(false) @map("habilitar_ranking_fidelidade")
  habilitarAgendamento         Boolean @default(false) @map("habilitar_agendamento")
  habilitarAvaliacaoComFotos   Boolean @default(false) @map("habilitar_avaliacao_com_fotos")
  habilitarNotificacoesInApp   Boolean @default(false) @map("habilitar_notificacoes_in_app")
  habilitarMissoes             Boolean @default(false) @map("habilitar_missoes")
  habilitarIndicacaoAvancada   Boolean @default(false) @map("habilitar_indicacao_avancada")
  habilitarAvaliacaoDetalhada  Boolean @default(false) @map("habilitar_avaliacao_detalhada")
  habilitarCentralSuporte      Boolean @default(false) @map("habilitar_central_suporte")

  // PDV (venda de balcão/mesa direto no app do lojista) — núcleo: venda + pagamento + caixa.
  /// Libera a aba PDV no app Flutter da loja.
  pdvHabilitado            Boolean @default(false) @map("pdv_habilitado")
  /// Cada tenant escolhe o comportamento que se adequa ao seu negócio: false = mesa é fechada de
  /// uma vez só (como uma venda de balcão nomeada); true = mesa fica aberta recebendo itens aos
  /// poucos até ser fechada e paga no final.
  pdvMesaAbertaContinua    Boolean @default(false) @map("pdv_mesa_aberta_continua")
  /// Cada tenant escolhe: false = uma forma de pagamento por venda (padrão); true = permite
  /// dividir a mesma venda em mais de uma forma (ex: metade Pix, metade dinheiro).
  pdvPermiteSplitPagamento Boolean @default(false) @map("pdv_permite_split_pagamento")

  /// Unidades de fidelidade por indicação concluída — só usado quando habilitarIndicacaoAvancada=true (senão usa o padrão fixo de 3).
  indicacaoRecompensaUnidades Int @default(3) @map("indicacao_recompensa_unidades")

  // Configurações operacionais
  lojaAbertaManual      Boolean @default(true) @map("loja_aberta_manual") // botão de emergência "Loja Aberta/Fechada"
  usarHorarioAutomatico Boolean @default(false) @map("usar_horario_automatico") // se true, cruza com HorarioFuncionamento
  tempoEstimadoMin      Int?    @map("tempo_estimado_min") // minutos, ex: 40
  tempoEstimadoMax      Int?    @map("tempo_estimado_max") // minutos, ex: 60
  pedidoMinimo          Decimal @default(0) @map("pedido_minimo") @db.Decimal(10, 2)

  // Frete
  freteGratisAcimaDe Decimal? @map("frete_gratis_acima_de") @db.Decimal(10, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  motoboys          Motoboy[]
  movimentosCaixa   MovimentoCaixa[]
  produtos          Produto[]
  pedidos           Pedido[]
  clientes          Cliente[]
  gatewaysPagamento GatewayPagamento[]
  heroSlides        HeroSlide[]
  cupons            Cupom[]
  horarios          HorarioFuncionamento[]
  zonasEntrega      ZonaEntrega[]
  faturas           Fatura[]
  categorias        Categoria[]
  missoes           Missao[]
  ticketsSuporte    TicketSuporte[]
  movimentosCoins   CoinsMovimento[]
  operadoresPdv     OperadorPdv[]
  caixaSessoes      CaixaSessao[]

  planoId String? @map("plano_id") @db.Uuid
  plano   Plano?  @relation(fields: [planoId], references: [id], onDelete: SetNull)

  @@map("empresas")
}

/// Plano de assinatura da plataforma (modelo fixo + comissão), ex: "Básico R$99/mês + 5%".
model Plano {
  id              String   @id @default(uuid()) @db.Uuid
  nome            String
  valorMensal     Decimal  @default(0) @map("valor_mensal") @db.Decimal(10, 2)
  comissaoPercent Decimal  @map("comissao_percent") @db.Decimal(5, 2)
  descricao       String?
  ativo           Boolean  @default(true)
  ordem           Int      @default(0)

  /// Lista de recursos exibidos na página do plano (ex: "Gestão de pedidos", "Dashboard", ...).
  recursos String[] @default([])

  /// Limites do plano; null = ilimitado (dentro da política de uso justo da plataforma).
  limitePedidosMes   Int? @map("limite_pedidos_mes")
  limiteProdutos     Int? @map("limite_produtos")
  limiteUsuarios     Int? @map("limite_usuarios")
  limiteEntregadores Int? @map("limite_entregadores")

  /// Marca o plano com o selo "Mais Popular" na listagem.
  destaque Boolean @default(false)

  /// Pacote de funcionalidades incluídas no plano — sincronizado pra Empresa quando o Super
  /// Admin atribui este plano a uma loja (PATCH /empresas/:id/plano). Mesmos 10 campos que
  /// Empresa já tem; o Super Admin ainda pode ligar/desligar um campo pontual numa loja depois,
  /// como exceção, sem precisar trocar o plano dela.
  habilitarFavoritos          Boolean @default(false) @map("habilitar_favoritos")
  habilitarPedirDeNovo        Boolean @default(false) @map("habilitar_pedir_de_novo")
  habilitarRankingFidelidade  Boolean @default(false) @map("habilitar_ranking_fidelidade")
  habilitarAgendamento        Boolean @default(false) @map("habilitar_agendamento")
  habilitarAvaliacaoComFotos  Boolean @default(false) @map("habilitar_avaliacao_com_fotos")
  habilitarNotificacoesInApp  Boolean @default(false) @map("habilitar_notificacoes_in_app")
  habilitarMissoes            Boolean @default(false) @map("habilitar_missoes")
  habilitarIndicacaoAvancada  Boolean @default(false) @map("habilitar_indicacao_avancada")
  habilitarAvaliacaoDetalhada Boolean @default(false) @map("habilitar_avaliacao_detalhada")
  habilitarCentralSuporte     Boolean @default(false) @map("habilitar_central_suporte")
  /// PDV (venda de balcão/mesa) — 11ª função do pacote, governada pelo Super Admin como as outras.
  pdvHabilitado               Boolean @default(false) @map("pdv_habilitado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  empresas Empresa[]
  leadsComerciais LeadComercial[]

  @@map("planos")
}

enum StatusLeadComercial {
  NOVO
  CONTATADO
  CONVERTIDO
  DESCARTADO
}

/// Contato comercial de um prospect interessado em virar parceiro — capturado pelo drawer de
/// contato no site público (front/src/components/ContatoComercialDrawer.tsx), visível só pro
/// Super Admin. Não tem relação com Cliente/Empresa: quem preenche ainda não é tenant nenhum.
model LeadComercial {
  id               String              @id @default(uuid()) @db.Uuid
  nome             String
  email            String
  telefone         String?
  mensagem         String?
  planoInteresseId String?             @map("plano_interesse_id") @db.Uuid
  planoInteresse   Plano?              @relation(fields: [planoInteresseId], references: [id], onDelete: SetNull)
  status           StatusLeadComercial @default(NOVO)
  /// Anotação privada do Super Admin sobre o andamento da negociação — nunca visível ao lead.
  notaInterna      String?             @map("nota_interna")
  /// De qual página pública veio ("landing" ou "parceiro") — só pra saber o que está convertendo.
  origem           String?
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@map("leads_comerciais")
}

enum PaginaSite {
  LANDING
  PARCEIRO
  PLANOS
  RECURSOS
  POLITICA_PRIVACIDADE
}

enum TipoBlocoSite {
  HERO
  LISTA_ICONES
  CTA_BANNER
}

/// Bloco de conteúdo editável do site público (CMS v1, Super Admin). Cada bloco ocupa um slot
/// fixo (chave) definido pelo código do front — nunca criado livremente com uma chave arbitrária,
/// porque só existe efeito visual se a página correspondente souber ler aquela chave. HERO e
/// CTA_BANNER usam os campos de texto abaixo; LISTA_ICONES ignora-os e usa só "itens".
model SiteBloco {
  id     String        @id @default(uuid()) @db.Uuid
  pagina PaginaSite
  chave  String
  tipo   TipoBlocoSite
  ativo  Boolean       @default(true)
  ordem  Int           @default(0)

  eyebrow    String?
  icone      String?
  titulo     String?
  subtitulo  String?
  texto      String?
  textoBotao String? @map("texto_botao")
  /// Caminho interno (ex: "/parceiro") ou o sentinel "abrir-contato" pra abrir o
  /// ContatoComercialDrawer da própria página em vez de navegar. Só usado em CTA_BANNER.
  linkBotao  String? @map("link_botao")

  /// Só em LISTA_ICONES: array de { icone, titulo, texto }. A ordem do array já é a ordem visual.
  itens Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([pagina, chave])
  @@map("site_blocos")
}

enum StatusFatura {
  PENDENTE
  PAGO
  ATRASADO
}

/// Fatura de comissão (+ mensalidade do plano, se houver) gerada por período para uma empresa.
model Fatura {
  id              String       @id @default(uuid()) @db.Uuid
  empresaId       String       @map("empresa_id") @db.Uuid
  empresa         Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  periodoInicio   DateTime     @map("periodo_inicio") @db.Date
  periodoFim      DateTime     @map("periodo_fim") @db.Date
  valorVendas     Decimal      @map("valor_vendas") @db.Decimal(12, 2)
  comissaoPercent Decimal      @map("comissao_percent") @db.Decimal(5, 2)
  valorComissao   Decimal      @map("valor_comissao") @db.Decimal(10, 2)
  valorPlano      Decimal      @default(0) @map("valor_plano") @db.Decimal(10, 2)
  valorTotal      Decimal      @map("valor_total") @db.Decimal(10, 2)
  /// Crédito de indicação de loja abatido nesta fatura (Empresa.creditoIndicacaoEmpresa), já refletido no valorTotal acima.
  creditoIndicacaoAplicado Decimal? @map("credito_indicacao_aplicado") @db.Decimal(10, 2)
  status          StatusFatura @default(PENDENTE)
  vencimento      DateTime     @db.Date
  pagoEm          DateTime?    @map("pago_em")
  observacoes     String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([empresaId, periodoInicio, periodoFim])
  @@map("faturas")
}

enum TipoLog {
  ACESSO
  ERRO
  ALTERACAO_CRITICA
}

/// Log de auditoria leve: acessos, erros do servidor e alterações críticas feitas pelo Super Admin.
/// Sem FK para Empresa de propósito — o log deve sobreviver mesmo se a empresa for excluída depois.
model LogAuditoria {
  id          String   @id @default(uuid()) @db.Uuid
  tipo        TipoLog
  empresaId   String?  @map("empresa_id") @db.Uuid
  empresaNome String?  @map("empresa_nome")
  ator        String?
  acao        String
  detalhes    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("logs_auditoria")
}

/// Configurações globais da plataforma (dona: Sigma Soluções Digitais). Linha única (singleton).
model ConfiguracaoPlataforma {
  id                   String   @id @default(uuid()) @db.Uuid
  nomeEmpresa          String   @default("Sigma Soluções Digitais") @map("nome_empresa")
  documento            String?
  emailSuporte         String?  @map("email_suporte")
  telefoneSuporte      String?  @map("telefone_suporte")
  endereco             String?
  termosPadraoLojistas String?  @map("termos_padrao_lojistas")
  chavesGlobais        Json?    @map("chaves_globais")
  /// Crédito em R$ dado a um tenant quando uma loja indicada por ele paga a 1ª fatura. 0 = programa desativado.
  recompensaIndicacaoEmpresaValor Decimal @default(0) @map("recompensa_indicacao_empresa_valor") @db.Decimal(10, 2)
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("configuracoes_plataforma")
}

/// Horário de funcionamento por dia da semana (0=domingo ... 6=sábado), usado quando usarHorarioAutomatico=true.
model HorarioFuncionamento {
  id        String  @id @default(uuid()) @db.Uuid
  empresaId String  @map("empresa_id") @db.Uuid
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  diaSemana Int     @map("dia_semana")
  abre      String? // "08:00"
  fecha     String? // "22:00"
  fechado   Boolean @default(false)

  @@unique([empresaId, diaSemana])
  @@map("horarios_funcionamento")
}

enum TipoZonaEntrega {
  BAIRRO
  RAIO_KM
  FAIXA_DISTANCIA
}

/// Taxa de entrega por bairro, raio em km, ou faixa de distância. O cálculo automático no checkout hoje
/// usa apenas o casamento por bairro (RAIO_KM/FAIXA_DISTANCIA exigem geocodificação, fora do escopo atual).
model ZonaEntrega {
  id             String          @id @default(uuid()) @db.Uuid
  empresaId      String          @map("empresa_id") @db.Uuid
  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  tipo           TipoZonaEntrega @default(BAIRRO)
  bairro         String?
  distanciaDeKm  Decimal?        @map("distancia_de_km") @db.Decimal(6, 2)
  distanciaAteKm Decimal?        @map("distancia_ate_km") @db.Decimal(6, 2)
  taxa           Decimal         @db.Decimal(10, 2)
  ativo          Boolean         @default(true)
  ordem          Int             @default(0)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("zonas_entrega")
}

model Cliente {
  id                     String   @id @default(uuid()) @db.Uuid
  empresaId              String   @map("empresa_id") @db.Uuid
  empresa                Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome                   String
  telefone               String?
  /// Nulos quando o cliente foi criado via "cadastro rápido" no PDV (só nome/telefone, sem
  /// conta própria pra logar depois) — @@unique abaixo tolera múltiplos null normalmente.
  email                  String?
  senhaHash              String?  @map("senha_hash")

  // Fidelidade: a cada 10 unidades de itens compradas (em pedidos ENTREGUES), 1 item grátis é liberado.
  totalUnidadesCompradas Int       @default(0) @map("total_unidades_compradas")
  itensGratisGanhos      Int       @default(0) @map("itens_gratis_ganhos")
  itensGratisResgatados  Int       @default(0) @map("itens_gratis_resgatados")
  /// Quando o item grátis mais recente foi liberado — usado para calcular o prazo de validade (Empresa.fidelidadeValidadeDias).
  itemGratisGanhoEm      DateTime? @map("item_gratis_ganho_em")

  // Indicação: cada cliente tem um código próprio pra compartilhar; quem se cadastra usando o
  // código de alguém fica marcado como indicado, e os dois ganham unidades de fidelidade quando
  // o indicado completa a primeira compra (ver PATCH /pedidos/:id/status).
  codigoIndicacao       String?   @map("codigo_indicacao")
  indicadoPorId         String?   @map("indicado_por_id") @db.Uuid
  indicadoPor           Cliente?  @relation("Indicacoes", fields: [indicadoPorId], references: [id], onDelete: SetNull)
  indicados             Cliente[] @relation("Indicacoes")
  indicacaoRecompensada Boolean   @default(false) @map("indicacao_recompensada")
  /// Total de indicações concluídas por este cliente (como indicador) — só cresce quando Empresa.habilitarIndicacaoAvancada=true. Usado pra liberar bônus de marco (3/10/25).
  indicacoesConcluidas  Int       @default(0) @map("indicacoes_concluidas")

  /// Saldo de cashback em R$, creditado (Empresa.cashbackPercent sobre o subtotal) quando um pedido é ENTREGUE, e debitado quando usado como desconto num pedido futuro.
  saldoCashback Decimal @default(0) @map("saldo_cashback") @db.Decimal(10, 2)

  /// Vínculo com a identidade de plataforma (SaltFood Coins) — null até o cliente vincular
  /// explicitamente com confirmação de senha (ver api/src/lib/contaPlataforma.js). Nunca é
  /// preenchido automaticamente só por bater o e-mail, pra não permitir herdar saldo alheio.
  contaPlataformaId String?          @map("conta_plataforma_id") @db.Uuid
  contaPlataforma   ContaPlataforma? @relation(fields: [contaPlataformaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pedidos         Pedido[]
  enderecos       EnderecoCliente[]
  favoritos       Favorito[]
  cuponsRecebidos Cupom[]
  notificacoes    NotificacaoCliente[]
  missoes         MissaoCliente[]
  ticketsSuporte  TicketSuporte[]
  movimentosCoins CoinsMovimento[]

  @@unique([empresaId, email])
  @@unique([empresaId, codigoIndicacao])
  @@map("clientes")
}

/// Identidade de plataforma (SaltFood Coins) — primeiro model verdadeiramente global do schema,
/// sem empresaId. Cada Cliente (que continua por loja, login/senha próprios) pode se vincular a
/// uma destas pra compartilhar saldo entre lojas. Vínculo exige confirmação de senha (ver
/// api/src/lib/contaPlataforma.js) — nunca é automático só por bater o e-mail.
model ContaPlataforma {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @unique
  telefone   String?
  /// Hash da senha do primeiro Cliente que criou esta conta — usado só pra confirmar vínculo de
  /// outra loja (comparado com bcrypt), nunca pra autenticar login diretamente.
  senhaHash  String   @map("senha_hash")
  saldoCoins Decimal  @default(0) @map("saldo_coins") @db.Decimal(10, 2)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  clientes        Cliente[]
  movimentosCoins CoinsMovimento[]

  @@map("contas_plataforma")
}

enum TipoCoinsMovimento {
  GANHO
  GASTO
}

/// Ledger de SaltFood Coins — ao contrário de Cliente.saldoCashback (só um Decimal que sobe/desce
/// sem histórico), aqui toda variação de saldo gera uma linha, porque o saldo é compartilhado
/// entre lojas (ganho numa, gasto noutra) e precisa de trilha auditável.
model CoinsMovimento {
  id                String             @id @default(uuid()) @db.Uuid
  contaPlataformaId String             @map("conta_plataforma_id") @db.Uuid
  contaPlataforma   ContaPlataforma    @relation(fields: [contaPlataformaId], references: [id], onDelete: Cascade)
  empresaId         String             @map("empresa_id") @db.Uuid
  empresa           Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  clienteId         String             @map("cliente_id") @db.Uuid
  cliente           Cliente            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pedidoId          String?            @map("pedido_id") @db.Uuid
  pedido            Pedido?            @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  tipo              TipoCoinsMovimento
  valor             Decimal            @db.Decimal(10, 2)
  createdAt         DateTime           @default(now()) @map("created_at")

  @@map("coins_movimentos")
}

/// Produto favoritado por um cliente, pra achar rápido de novo na loja.
model Favorito {
  id        String   @id @default(uuid()) @db.Uuid
  clienteId String   @map("cliente_id") @db.Uuid
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produtoId String   @map("produto_id") @db.Uuid
  produto   Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([clienteId, produtoId])
  @@map("favoritos")
}

model EnderecoCliente {
  id          String  @id @default(uuid()) @db.Uuid
  clienteId   String  @map("cliente_id") @db.Uuid
  cliente     Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  rotulo      String // "Casa", "Trabalho", "Apto", etc.
  cep         String?
  endereco    String
  numero      String?
  bairro      String?
  cidade      String?
  referencia  String?
  principal   Boolean @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("enderecos_cliente")
}

enum ProvedorGateway {
  PIX_MANUAL
  PAGSEGURO
  MERCADOPAGO
  STRIPE
}

model GatewayPagamento {
  id            String          @id @default(uuid()) @db.Uuid
  empresaId     String          @map("empresa_id") @db.Uuid
  empresa       Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  provider      ProvedorGateway
  nomeExibicao  String          @map("nome_exibicao")
  ativo         Boolean         @default(false)
  chavePublica  String?         @map("chave_publica")
  chaveSecreta  String?         @map("chave_secreta")
  webhookSecret String?         @map("webhook_secret")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([empresaId, provider])
  @@map("gateways_pagamento")
}

enum TipoCupom {
  PERCENTUAL
  VALOR_FIXO
  FRETE_GRATIS
}

model Cupom {
  id                   String    @id @default(uuid()) @db.Uuid
  empresaId            String    @map("empresa_id") @db.Uuid
  empresa              Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  codigo               String
  descricao            String?
  tipo                 TipoCupom
  valor                Decimal?  @db.Decimal(10, 2) // percentual (0-100) ou valor fixo em R$; nulo p/ FRETE_GRATIS
  apenasPrimeiraCompra Boolean   @default(false) @map("apenas_primeira_compra")
  valorMinimoPedido    Decimal?  @map("valor_minimo_pedido") @db.Decimal(10, 2)
  usoMaximo            Int?      @map("uso_maximo") // null = ilimitado
  usosRealizados       Int       @default(0) @map("usos_realizados")
  /// Início de vigência — null = vale desde a criação. Cupom com validoDe no futuro aparece como "Agendado" no admin.
  validoDe             DateTime? @map("valido_de")
  validoAte            DateTime? @map("valido_ate")
  ativo                Boolean   @default(true)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  /// Quando preenchido, o cupom é privado — só esse cliente pode aplicá-lo (ex: campanha "sentimos sua falta"). Null = cupom público, qualquer cliente da loja pode usar.
  clienteAlvoId        String?   @map("cliente_alvo_id") @db.Uuid
  clienteAlvo          Cliente?  @relation(fields: [clienteAlvoId], references: [id], onDelete: Cascade)

  /// Vazio = vale em qualquer bairro. Texto livre pra bater com Pedido.bairro (mesmo padrão de ZonaEntrega).
  bairrosRestritos       String[]        @default([]) @map("bairros_restritos")
  /// Null = qualquer forma de pagamento.
  formaPagamentoRestrita FormaPagamento? @map("forma_pagamento_restrita")
  /// 0=domingo..6=sábado. Null = todos os dias.
  diaSemanaRestrito      Int?            @map("dia_semana_restrito")
  /// Só clientes tier PRATA/OURO (totalUnidadesCompradas >= 20 — mesmo corte de front/src/types/Cliente.ts:loyaltyTier).
  apenasClientesFieis    Boolean         @default(false) @map("apenas_clientes_fieis")

  pedidos Pedido[]

  @@unique([empresaId, codigo])
  @@map("cupons")
}

/// Categoria de produtos de uma loja (ex: "Acarajés", "Combos"), gerenciada pelo admin do tenant.
/// Controla também a ordem/abas de navegação exibidas para o cliente na loja pública.
model Categoria {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  produtos Produto[]

  @@map("categorias")
}

model Produto {
  id               String     @id @default(uuid()) @db.Uuid
  empresaId        String     @map("empresa_id") @db.Uuid
  empresa          Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome             String
  /// Código/SKU livre pro lojista organizar o catálogo (ex: "AC001") — opcional, sem checagem de unicidade.
  codigo           String?
  descricao        String?
  categoriaId      String?    @map("categoria_id") @db.Uuid
  categoria        Categoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  preco            Decimal  @db.Decimal(10, 2)
  precoPromocional Decimal? @map("preco_promocional") @db.Decimal(10, 2)
  fotoUrl          String?  @map("foto_url")
  ativo            Boolean  @default(true)
  ordem            Int      @default(0)
  /// Marca o produto como combo (composto por vários itens) — exibido como selo nos pedidos.
  ehCombo          Boolean  @default(false) @map("eh_combo")

  // Estoque & insumos
  esgotadoHoje     Boolean  @default(false) @map("esgotado_hoje") // pausa rápida sem desativar/excluir o produto
  controlarEstoque Boolean  @default(false) @map("controlar_estoque")
  estoqueQtd       Int?     @map("estoque_qtd") // só relevante quando controlarEstoque=true
  /// Dispara alerta de estoque baixo no dashboard quando estoqueQtd cai a este nível ou abaixo — opcional, sem alerta se null.
  estoqueMinimo    Int?     @map("estoque_minimo")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  itensPedido PedidoItem[]
  variacoes   ProdutoVariacao[]
  gruposOpcao ProdutoGrupoOpcao[]
  favoritos   Favorito[]

  @@map("produtos")
}

/// Grupo de opções/complementos de um produto (ex: "Monte seu acarajé", "Adicionais").
/// Definido pelo admin de cada loja, por produto — cada tenant configura o seu.
model ProdutoGrupoOpcao {
  id              String   @id @default(uuid()) @db.Uuid
  produtoId       String   @map("produto_id") @db.Uuid
  produto         Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nome            String
  /// Se true, o cliente precisa selecionar ao menos minSelecoes itens deste grupo para adicionar ao carrinho.
  obrigatorio     Boolean  @default(false)
  /// true = caixas de seleção (pode marcar vários); false = seleção única (rádio).
  selecaoMultipla Boolean  @default(true) @map("selecao_multipla")
  minSelecoes     Int      @default(0) @map("min_selecoes")
  maxSelecoes     Int?     @map("max_selecoes")
  ordem           Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  opcoes ProdutoOpcao[]

  @@map("produto_grupos_opcao")
}

/// Item selecionável dentro de um grupo de opções (ex: "Camarão", "Pimenta", "Carne extra").
/// precoAdicional = 0 significa incluso sem custo extra; > 0 é cobrado a mais por unidade do produto.
model ProdutoOpcao {
  id             String            @id @default(uuid()) @db.Uuid
  grupoId        String            @map("grupo_id") @db.Uuid
  grupo          ProdutoGrupoOpcao @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  nome           String
  precoAdicional Decimal           @default(0) @map("preco_adicional") @db.Decimal(10, 2)
  /// Se true, a opção já vem marcada/inclusa por padrão no modal do cliente (ele desmarca o que não quiser).
  selecionadoPorPadrao Boolean     @default(false) @map("selecionado_por_padrao")
  /// Foto e subtítulo opcionais, usados quando o grupo é exibido como cartões (ex: "No Saquinho" x "No Prato").
  fotoUrl        String?           @map("foto_url")
  descricao      String?
  ativo          Boolean           @default(true)
  ordem          Int               @default(0)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  itensPedido PedidoItemOpcao[]

  @@map("produto_opcoes")
}

/// Variação/sabor de um produto com estoque próprio (ex: "Camarão", "Frango"). Gerenciado no admin;
/// a seleção de variação pelo cliente na loja fica fora do escopo desta etapa (marcado como avançado/opcional).
model ProdutoVariacao {
  id         String   @id @default(uuid()) @db.Uuid
  produtoId  String   @map("produto_id") @db.Uuid
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  nome       String
  estoqueQtd Int?     @map("estoque_qtd")
  ativo      Boolean  @default(true)
  ordem      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("produto_variacoes")
}

model Motoboy {
  id         String   @id @default(uuid()) @db.Uuid
  empresaId  String   @map("empresa_id") @db.Uuid
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome       String
  telefone   String?
  taxaPadrao Decimal  @default(7.00) @map("taxa_padrao") @db.Decimal(10, 2)
  pinHash    String?  @map("pin_hash")
  ativo      Boolean  @default(true)

  /// Última posição GPS compartilhada pelo motoboy (navigator.geolocation do navegador — gratuito, sem chave de API).
  latitudeAtual            Decimal?  @map("latitude_atual") @db.Decimal(10, 7)
  longitudeAtual           Decimal?  @map("longitude_atual") @db.Decimal(10, 7)
  localizacaoAtualizadaEm  DateTime? @map("localizacao_atualizada_em")

  /// Toggle manual que o próprio motoboy liga/desliga no portal dele, pra sinalizar ao admin se está livre pra nova corrida. Escopo só desta loja — não é um pool de motoboys da plataforma.
  disponivel Boolean @default(true)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  movimentosCaixa MovimentoCaixa[]
  pedidos         Pedido[]

  @@map("motoboys")
}

enum FormaPagamento {
  PIX
  DINHEIRO
  CARTAO
  /// Venda paga em mais de uma forma (PDV) — ver PedidoPagamento.
  MULTIPLO
}

enum StatusPedido {
  RECEBIDO
  PREPARANDO
  SAIU_ENTREGA
  ENTREGUE
  CANCELADO
}

/// Canal/origem do pedido. DELIVERY é o padrão (todo pedido de hoje é DELIVERY) — os outros 3 são
/// o núcleo do PDV, criado direto no app da loja.
enum TipoPedido {
  DELIVERY
  BALCAO
  MESA
  RETIRADA
}

model Pedido {
  id              String         @id @default(uuid()) @db.Uuid
  empresaId       String         @map("empresa_id") @db.Uuid
  empresa         Empresa        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero          Int

  /// DELIVERY (padrão, todo pedido de hoje) ou o núcleo do PDV — balcão/mesa/retirada, criados
  /// direto no app da loja. Decide quais campos abaixo são exigidos (ver POST /pedidos).
  tipoPedido        TipoPedido @default(DELIVERY) @map("tipo_pedido")
  /// Identificador livre da mesa/comanda (ex: "Mesa 5") — só usado quando tipoPedido=MESA.
  mesaIdentificador String?    @map("mesa_identificador")

  /// Nulos em pedidos de balcão/mesa/retirada sem cliente identificado ("venda sem
  /// identificação") — continuam obrigatórios pra tipoPedido=DELIVERY (validado na rota).
  clienteNome     String?        @map("cliente_nome")
  clienteTelefone String?        @map("cliente_telefone")
  endereco        String?
  bairro          String?
  referencia      String?

  subtotal        Decimal        @db.Decimal(10, 2)
  taxaEntrega     Decimal        @map("taxa_entrega") @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)

  formaPagamento  FormaPagamento @map("forma_pagamento")
  trocoPara       Decimal?       @map("troco_para") @db.Decimal(10, 2)

  /// Confirmação de que o valor da entrega (pix/dinheiro/cartão) foi efetivamente recebido —
  /// obrigatória pra transição pra ENTREGUE, pra permitir conferir o caixa de cada motoboy.
  pagamentoConfirmado        Boolean  @default(false) @map("pagamento_confirmado")
  valorRecebido              Decimal? @map("valor_recebido") @db.Decimal(10, 2)
  pagamentoConfirmadoPorRole String?  @map("pagamento_confirmado_por_role")
  /// Linhas de pagamento quando a venda é dividida em mais de uma forma (PDV, ver
  /// Empresa.pdvPermiteSplitPagamento) — quando vazio, os campos flat acima é que valem.
  pagamentos                 PedidoPagamento[]

  /// Ajuste manual aplicado pelo EMPRESA_ADMIN no PDV (nunca pelo MOTOBOY) — desconto/acréscimo
  /// avulso, sem cupom nem conta de cliente por trás.
  descontoManual     Decimal? @map("desconto_manual") @db.Decimal(10, 2)
  acrescimoManual    Decimal? @map("acrescimo_manual") @db.Decimal(10, 2)
  motivoAjusteManual String?  @map("motivo_ajuste_manual")

  status          StatusPedido   @default(RECEBIDO)
  observacoes     String?

  /// Preenchido só quando o cliente escolhe "agendar" no checkout em vez de "pedir agora" — horário desejado de entrega/retirada.
  agendadoPara DateTime? @map("agendado_para")

  /// User-Agent bruto do navegador no momento do checkout — só usado pro Super Admin ver mix de dispositivo/navegador agregado da plataforma (nunca por pedido/cliente individual).
  userAgent String? @map("user_agent")

  motoboyId          String?  @map("motoboy_id") @db.Uuid
  motoboy            Motoboy? @relation(fields: [motoboyId], references: [id], onDelete: SetNull)
  taxaEntregaMotoboy Decimal? @map("taxa_entrega_motoboy") @db.Decimal(10, 2)
  motoboyPago        Boolean  @default(false) @map("motoboy_pago")
  /// Foto anexada pelo motoboy como comprovante ao confirmar a entrega (ENTREGUE).
  fotoEntrega        String?  @map("foto_entrega")

  // Fidelidade
  clienteId                     String?  @map("cliente_id") @db.Uuid
  cliente                       Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  itemGratisResgatado           Boolean  @default(false) @map("item_gratis_resgatado")
  unidadesFidelidadeCreditadas  Int?     @map("unidades_fidelidade_creditadas") // preenchido 1x ao entregar, evita crédito duplicado

  // Cashback: usado (debitado do saldo, como desconto) na criação do pedido; creditado (Empresa.cashbackPercent) 1x ao entregar.
  cashbackUsado      Decimal? @map("cashback_usado") @db.Decimal(10, 2)
  cashbackCreditado  Decimal? @map("cashback_creditado") @db.Decimal(10, 2) // preenchido 1x ao entregar, evita crédito duplicado

  // SaltFood Coins: mesmo padrão do cashback acima, mas gravado também no ledger CoinsMovimento
  // (ver abaixo), já que o saldo é compartilhado entre lojas.
  coinsUsado     Decimal? @map("coins_usado") @db.Decimal(10, 2)
  coinsCreditado Decimal? @map("coins_creditado") @db.Decimal(10, 2)

  // Cupom aplicado (snapshot do código, pois o cupom pode mudar/expirar depois)
  cupomId        String?  @map("cupom_id") @db.Uuid
  cupom          Cupom?   @relation(fields: [cupomId], references: [id], onDelete: SetNull)
  cupomCodigo    String?  @map("cupom_codigo")
  descontoCupom  Decimal? @map("desconto_cupom") @db.Decimal(10, 2)

  // Avaliações (só liberadas após ENTREGUE)
  notaPedido        Int?      @map("nota_pedido")
  comentarioPedido  String?   @map("comentario_pedido")
  /// URLs das fotos anexadas pelo cliente na avaliação (upload usa a mesma rota /uploads já existente).
  fotosAvaliacao    String[]  @default([]) @map("fotos_avaliacao")
  /// Notas por dimensão (1-5) — só coletadas quando Empresa.habilitarAvaliacaoDetalhada=true, além da notaPedido geral.
  notaComida        Int?      @map("nota_comida")
  notaEmbalagem     Int?      @map("nota_embalagem")
  notaTempo         Int?      @map("nota_tempo")
  avaliadoEm        DateTime? @map("avaliado_em")
  notaMotoboy       Int?      @map("nota_motoboy")
  comentarioMotoboy String?   @map("comentario_motoboy")
  motoboyAvaliadoEm DateTime? @map("motoboy_avaliado_em")

  createdAt      DateTime  @default(now()) @map("created_at")
  preparandoEm   DateTime? @map("preparando_em")
  saiuEntregaEm  DateTime? @map("saiu_entrega_em")
  entregueEm     DateTime? @map("entregue_em")
  canceladoEm    DateTime? @map("cancelado_em")

  itens             PedidoItem[]
  pushSubscriptions PushSubscription[]
  ticketsSuporte    TicketSuporte[]
  movimentosCoins   CoinsMovimento[]
  movimentosCaixa   MovimentoCaixa[]

  @@unique([empresaId, numero])
  @@map("pedidos")
}

/// Uma linha de pagamento de um Pedido pago em mais de uma forma (PDV com split habilitado) —
/// ver Empresa.pdvPermiteSplitPagamento. Quando a venda usa uma forma só, essa tabela fica vazia
/// e os campos flat em Pedido (formaPagamento/valorRecebido/trocoPara) continuam valendo.
model PedidoPagamento {
  id             String         @id @default(uuid()) @db.Uuid
  pedidoId       String         @map("pedido_id") @db.Uuid
  pedido         Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  formaPagamento FormaPagamento @map("forma_pagamento")
  valor          Decimal        @db.Decimal(10, 2)
  trocoPara      Decimal?       @map("troco_para") @db.Decimal(10, 2)
  createdAt      DateTime       @default(now()) @map("created_at")

  @@map("pedido_pagamentos")
}

/// Inscrição de push do navegador na página de acompanhamento de um pedido — permite avisar
/// (sem precisar de app nativo) quando o status mudar, mesmo com a aba fechada.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  pedidoId  String   @map("pedido_id") @db.Uuid
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("push_subscriptions")
}

/// Feed de notificações in-app do cliente (sininho) — complementa o push, funciona mesmo sem
/// permissão de notificação concedida no navegador. Gerado nos mesmos eventos que disparam push.
model NotificacaoCliente {
  id        String   @id @default(uuid()) @db.Uuid
  clienteId String   @map("cliente_id") @db.Uuid
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  titulo    String
  corpo     String
  url       String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notificacoes_cliente")
}

/// Missão de fidelidade configurada pela loja (ex: "Peça 3x essa semana e ganhe 5 unidades").
/// O cliente aceita a missão (cria um MissaoCliente) e ela é avaliada nos pedidos ENTREGUES a
/// partir do momento em que foi aceita, dentro da janela de periodoDias.
model Missao {
  id                 String   @id @default(uuid()) @db.Uuid
  empresaId          String   @map("empresa_id") @db.Uuid
  empresa            Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  titulo             String
  descricao          String?
  metaPedidos        Int      @map("meta_pedidos")
  periodoDias        Int      @map("periodo_dias")
  recompensaUnidades Int      @map("recompensa_unidades")
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  participacoes MissaoCliente[]

  @@map("missoes")
}

/// Participação de um cliente numa missão — 1 tentativa ativa por vez (reaceitar depois de
/// concluir ou expirar cria uma nova linha, não reaproveita esta).
model MissaoCliente {
  id           String    @id @default(uuid()) @db.Uuid
  missaoId     String    @map("missao_id") @db.Uuid
  missao       Missao    @relation(fields: [missaoId], references: [id], onDelete: Cascade)
  clienteId    String    @map("cliente_id") @db.Uuid
  cliente      Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  iniciadaEm   DateTime  @default(now()) @map("iniciada_em")
  concluidaEm  DateTime? @map("concluida_em")
  recompensada Boolean   @default(false)

  @@map("missoes_clientes")
}

enum StatusTicketSuporte {
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
}

/// SLA informativo (sem fila/alerta automático) pros chamados que o lojista abre com a Sigma —
/// null pros tickets de cliente pra loja (esses não usam prioridade).
enum PrioridadeChamado {
  RELEVANTE
  PRIORITARIA
  URGENTE
}

/// Central de suporte: cliente relata um problema (opcionalmente ligado a um pedido), admin
/// responde e resolve. Gera notificação in-app pro cliente quando o admin responde/resolve
/// (se Empresa.habilitarNotificacoesInApp também estiver ligado). Quando clienteId é null, o
/// ticket é do lojista falando com a Sigma/plataforma (ver PrioridadeChamado), não de um cliente.
model TicketSuporte {
  id            String              @id @default(uuid()) @db.Uuid
  empresaId     String              @map("empresa_id") @db.Uuid
  empresa       Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pedidoId      String?             @map("pedido_id") @db.Uuid
  pedido        Pedido?             @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  clienteId     String?             @map("cliente_id") @db.Uuid
  cliente       Cliente?            @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  assunto       String
  mensagem      String
  status        StatusTicketSuporte @default(ABERTO)
  prioridade    PrioridadeChamado?
  respostaAdmin String?             @map("resposta_admin")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@map("tickets_suporte")
}

model PedidoItem {
  id            String   @id @default(uuid()) @db.Uuid
  pedidoId      String   @map("pedido_id") @db.Uuid
  pedido        Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String?  @map("produto_id") @db.Uuid
  produto       Produto? @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  nomeProduto   String   @map("nome_produto")
  /// Snapshot de Produto.ehCombo no momento da compra (mesmo padrão de nomeProduto/precoUnitario).
  ehCombo       Boolean  @default(false) @map("eh_combo")
  precoUnitario Decimal  @map("preco_unitario") @db.Decimal(10, 2)
  quantidade    Int
  observacoes   String?
  createdAt     DateTime @default(now()) @map("created_at")

  opcoesSelecionadas PedidoItemOpcao[]

  @@map("pedido_itens")
}

/// Snapshot das opções/complementos escolhidos pelo cliente para um item do pedido — preserva o que
/// foi escolhido mesmo que o produto/opção seja alterado ou removido depois.
model PedidoItemOpcao {
  id             String        @id @default(uuid()) @db.Uuid
  pedidoItemId   String        @map("pedido_item_id") @db.Uuid
  pedidoItem     PedidoItem    @relation(fields: [pedidoItemId], references: [id], onDelete: Cascade)
  opcaoId        String?       @map("opcao_id") @db.Uuid
  opcao          ProdutoOpcao? @relation(fields: [opcaoId], references: [id], onDelete: SetNull)
  nomeGrupo      String        @map("nome_grupo")
  nomeOpcao      String        @map("nome_opcao")
  precoAdicional Decimal       @map("preco_adicional") @db.Decimal(10, 2)

  @@map("pedido_item_opcoes")
}

enum TipoMovimentoCaixa {
  ENTRADA
  SAIDA
  SANGRIA
  /// Reforço de troco no meio do turno — distinto do fundo de troco inicial (CaixaSessao.fundoTroco).
  SUPRIMENTO
  FECHAMENTO
}

/// Tabela unificada de caixa: entradas, saídas e fechamentos de turno, tudo em um só lugar.
model MovimentoCaixa {
  id            String              @id @default(uuid()) @db.Uuid
  empresaId     String              @map("empresa_id") @db.Uuid
  empresa       Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  motoboyId     String?             @map("motoboy_id") @db.Uuid
  motoboy       Motoboy?            @relation(fields: [motoboyId], references: [id], onDelete: SetNull)
  tipo          TipoMovimentoCaixa
  descricao     String?
  valor         Decimal             @db.Decimal(10, 2)
  dataMovimento DateTime            @default(now()) @map("data_movimento") @db.Date
  createdAt     DateTime            @default(now()) @map("created_at")

  /// Sessão de caixa aberta no momento do lançamento — atribuída automaticamente pelo servidor
  /// (nunca vem do cliente), permite conferência/diferença por turno.
  caixaSessaoId String?      @map("caixa_sessao_id") @db.Uuid
  caixaSessao   CaixaSessao? @relation(fields: [caixaSessaoId], references: [id], onDelete: SetNull)
  /// Rastreabilidade até a venda que originou o lançamento (ex: qual Pedido gerou esta ENTRADA).
  pedidoId      String?      @map("pedido_id") @db.Uuid
  pedido        Pedido?      @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  /// Snapshot da forma de pagamento da venda — necessário pra separar "esperado em dinheiro" do
  /// resto na conferência de fechamento, principalmente quando a venda foi dividida (uma linha de
  /// MovimentoCaixa por PedidoPagamento).
  formaPagamento FormaPagamento? @map("forma_pagamento")

  @@map("movimentos_caixa")
}

enum StatusCaixa {
  ABERTO
  FECHADO
}

/// Sessão de caixa (abertura/fechamento de turno) — não existia antes: MovimentoCaixa era só uma
/// lista solta, sem fundo de troco, operador ou conferência de diferença. MVP: um caixa aberto
/// por vez por empresa (sem múltiplos terminais simultâneos).
model CaixaSessao {
  id           String       @id @default(uuid()) @db.Uuid
  empresaId    String       @map("empresa_id") @db.Uuid
  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  operadorId   String?      @map("operador_id") @db.Uuid
  operador     OperadorPdv? @relation(fields: [operadorId], references: [id], onDelete: SetNull)
  /// Snapshot do nome do operador — sobrevive mesmo se o OperadorPdv for removido depois.
  operadorNome String       @map("operador_nome")
  fundoTroco   Decimal      @default(0) @map("fundo_troco") @db.Decimal(10, 2)
  status       StatusCaixa  @default(ABERTO)
  abertoEm     DateTime     @default(now()) @map("aberto_em")
  fechadoEm    DateTime?    @map("fechado_em")

  /// Preenchidos só no fechamento: quanto foi contado fisicamente, quanto era esperado (fundo +
  /// entradas em dinheiro - saídas/sangrias + suprimentos) e a diferença entre os dois.
  valorContado          Decimal? @map("valor_contado") @db.Decimal(10, 2)
  valorEsperado         Decimal? @map("valor_esperado") @db.Decimal(10, 2)
  diferenca             Decimal? @db.Decimal(10, 2)
  observacoesFechamento String?  @map("observacoes_fechamento")

  movimentos MovimentoCaixa[]

  @@map("caixa_sessoes")
}

/// Identidade leve de quem opera o PDV (caixa/atendente) — sem login novo, o app continua
/// autenticado como EMPRESA_ADMIN. Serve só pra saber "quem" abriu cada CaixaSessao, pra
/// relatório de caixa por operador. Mesmo padrão de Motoboy.pinHash.
model OperadorPdv {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  nome      String
  pinHash   String?  @map("pin_hash")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  caixaSessoes CaixaSessao[]

  @@map("operadores_pdv")
}

/// Slide do carrossel do Hero (usado só quando Empresa.heroUsarCarrossel = true).
model HeroSlide {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  imagemUrl   String   @map("imagem_url")
  titulo      String
  subtitulo   String?
  badgeLabel  String?  @map("badge_label")
  linkUrl     String?  @map("link_url")
  ordem       Int      @default(0)
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("hero_slides")
}
