DATABASE_URL="postgresql://usuario:senha@host:porta/banco?schema=public"

# Origem do front — usada pra montar URLs absolutas (start_url/scope) no manifest de PWA por loja.
FRONT_ORIGIN="https://saltfood.com.br"

# String aleatória longa usada pra assinar/verificar os tokens de login. Gere uma nova com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-string-aleatoria-longa"

# Credencial do Super Admin (dono da plataforma) — usuário fica em texto puro, senha só em hash.
# Gere o hash com: node -e "require('bcryptjs').hash('SUA_SENHA', 10).then(console.log)"
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD_HASH="$2a$10$hash-gerado-com-bcryptjs"

# Par de chaves VAPID pra notificação push (atualização de status do pedido). Gere um novo com:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY="troque-pela-chave-publica-gerada"
VAPID_PRIVATE_KEY="troque-pela-chave-privada-gerada"
VAPID_SUBJECT="mailto:seu-email@dominio.com"
