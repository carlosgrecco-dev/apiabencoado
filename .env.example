DATABASE_URL="postgresql://usuario:senha@host:porta/banco?schema=public"

# String aleatória longa usada pra assinar/verificar os tokens de login. Gere uma nova com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-uma-string-aleatoria-longa"

# Credencial do Super Admin (dono da plataforma) — usuário fica em texto puro, senha só em hash.
# Gere o hash com: node -e "require('bcryptjs').hash('SUA_SENHA', 10).then(console.log)"
SUPER_ADMIN_USERNAME="admin"
SUPER_ADMIN_PASSWORD_HASH="$2a$10$hash-gerado-com-bcryptjs"
